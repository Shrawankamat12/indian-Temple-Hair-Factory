PORT=5000
NODE_ENV=development
MONGO_URI=
# REQUIRED: at least 32 random characters. Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production with a missing/placeholder value.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Optional dedicated key for encrypting payment secrets saved from Admin → Settings → Payments (falls back to JWT_SECRET).
SETTINGS_ENCRYPTION_KEY=
CLIENT_URL=
ADMIN_URL=

# Optional — if unset, image uploads fall back to local disk storage (src/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — defaults to "debug" in dev / "info" in production
LOG_LEVEL=

# ---- PayPal (server-side only; the secret is never sent to any browser) ----
# These are the FALLBACK. Anything saved in Admin → Settings → Payments takes precedence.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox        # sandbox | live
PAYPAL_WEBHOOK_ID=                # from the webhook you create in the PayPal developer dashboard

# Legacy Razorpay (no longer offered by the storefront; leave blank)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional — order shipping from admin falls back to unavailable if unset.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
